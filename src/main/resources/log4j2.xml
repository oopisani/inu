<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="OFF">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout disableAnsi="false"
                    pattern="%d{HH:mm:ss.SSS} [%t] %highlight{%-5level} %style{%logger{36}}{cyan} - %msg%n" />
        </Console>

        <RollingFile name="FileAppender" fileName="${sys:user.home}/inu-workspace/logs/app.log"
                     filePattern="${sys:user.home}/inu-workspace/logs/archive/app-week-%d{yyyy-ww}-%i.log.gz">

        <PatternLayout pattern = "%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
        <Policies>
            <TimeBasedTriggeringPolicy interval="1" modulate="true" />
            <SizeBasedTriggeringPolicy size="50 MB" />
        </Policies>

            <!-- app-04-27-2026-1.log.gz -->
        <DefaultRolloverStrategy>
            <Delete basePath = "${sys:user.home}/inu-workspace/logs/archive/" maxDepth="1">
                <IfFileName glob="app-week-*.log.gz" />
                <IfLastModified age="14d"/>
            </Delete>
        </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="console" />
            <AppenderRef ref="FileAppender" />
        </Root>
    </Loggers>
</Configuration>